# Jira Integration (optional — mock filing mode without these; ingestion requires credentials)
# JIRA_EMAIL=
# JIRA_API_TOKEN=
# JIRA_BASE_URL=https://your-org.atlassian.net
# JIRA_PROJECT_KEY=YOUR_PROJECT

# Confluence Integration (optional — falls back to JIRA_EMAIL / JIRA_API_TOKEN if unset)
# CONFLUENCE_BASE_URL=https://your-org.atlassian.net
# CONFLUENCE_EMAIL=
# CONFLUENCE_API_TOKEN=

PORT=3001

# Allow runs against production hosts (e.g. app.quloi.com) — dev/staging (*-dev, staging.*) are allowed without this
ALLOW_PRODUCTION_URL=true

# Ignore TLS cert errors on staging/self-signed hosts
IGNORE_HTTPS_ERRORS=true
